# Copy to .env and fill in. Never commit .env. (PRODUCT.md §13)

# AI (pay-per-use API keys, NOT the Claude/Gemini chat subscriptions)
ANTHROPIC_API_KEY=            # console.anthropic.com
GEMINI_API_KEY=               # Google AI Studio
AI_PROVIDER_MODE=mock         # mock | live

# Maps / business data
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_PLACES_API_KEY=        # optional alternative source

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # server only, never expose to the browser

# Cloudflare (client site hosting + previews)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PREVIEW_BASE_URL=             # separate preview domain
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (contact-form forwarding, e.g. Resend/Postmark)
EMAIL_API_KEY=

# App
ALLOWED_ADMIN_EMAIL=
MONTHLY_BUDGET_EUR=50
